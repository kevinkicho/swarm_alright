#!/usr/bin/env bash
# Unix/macOS wrapper — same role as bin/swarm.cmd on Windows.
set -euo pipefail
ROOT="${SWARM_HOME:-$(cd "$(dirname "$0")/.." && pwd)}"
CLI="$ROOT/src/cli.ts"
if [[ ! -f "$CLI" ]]; then
  echo "swarm: cannot find $CLI" >&2
  echo "Set SWARM_HOME to your swarm_alright repo root." >&2
  exit 1
fi
if ! command -v node >/dev/null 2>&1; then
  echo "swarm: node is not on PATH" >&2
  exit 1
fi
exec node --experimental-strip-types "$CLI" "$@"
