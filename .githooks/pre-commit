#!/bin/sh
# Offline host check before commit (Go primary).
set -e
cd "$(git rev-parse --show-toplevel)"
if [ -d go-swarm ]; then
  (cd go-swarm && go vet ./... && go test ./... && go build -o swarm_check.exe .)
elif command -v npm >/dev/null 2>&1 && npm run | grep -q " check"; then
  npm run check
else
  echo "pre-commit: no go-swarm/ and no npm check script" >&2
  exit 1
fi
